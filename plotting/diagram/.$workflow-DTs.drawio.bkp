        <mxCell id="t0dS66oqUHYe3xeXQDsh-8" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeWidth=2;shadow=0;glass=0;perimeterSpacing=0;flipH=1;flipV=1;strokeColor=default;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font color=&quot;#000000&quot; face=&quot;Helvetica&quot;&gt;&amp;nbsp;Model logic&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;b style=&quot;background-color: initial; font-family: I5Ys0xaoft8N1-NsVKcv;&quot;&gt;&lt;i&gt;d (S_w) / dt = R(t) + M(t) - E(t) - Q(t)&lt;/i&gt;&lt;/b&gt;&lt;font color=&quot;#000000&quot; face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot; face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;i&gt;S_w&lt;/i&gt;&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;water storage, mm&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;font face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;i&gt;M(t)&lt;/i&gt;&lt;/b&gt; Snowmelt&lt;/font&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;, mm/h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot; face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;M(t) = m{T(t) - Tsm}&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;&lt;b&gt;&lt;i&gt;E(t)&lt;/i&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;font face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;actual&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;evapotranspiration&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;, mm/h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot; face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;E(t) = gamma * PET(t)&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;&lt;b&gt;&lt;i&gt;Q(t)&lt;/i&gt;&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;font face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;runoff rate,&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;mm/h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font color=&quot;#000000&quot; face=&quot;I5Ys0xaoft8N1-NsVKcv&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Q(t) = 1/k * S_W(t) and one more case,&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;background-color: rgb(151, 208, 119);&quot;&gt;for Q(t)&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;font face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;i&gt;if&lt;/i&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;S_w(t) &amp;lt; S_tau, then,&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;i&gt;&lt;font face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;Q(t) =&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;1/k * S_W(t)&lt;/span&gt;&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;&quot;&gt;if&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;i style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: rgb(234, 107, 102);&quot;&gt;S_w(t) &amp;gt;= S_tau&lt;/i&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;,&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;&quot;&gt;&amp;nbsp;then,&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;i&gt;&lt;font face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;Q(t) =&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: I5Ys0xaoft8N1-NsVKcv; background-color: initial;&quot;&gt;S_W(t) - S_tau&lt;/span&gt;&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
