t;&lt;span style=&quot;background-color: initial;&quot;&gt;, \( W / m^2 \)&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;watts per square meter&lt;/span&gt;&lt;/p&gt;" vertex="1">
