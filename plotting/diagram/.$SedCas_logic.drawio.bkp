        <mxCell id="t0dS66oqUHYe3xeXQDsh-16" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;strokeWidth=2;shadow=0;glass=0;perimeterSpacing=0;flipH=1;flipV=1;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&amp;nbsp;Model logic&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;&lt;i&gt;d (S_c) / dt&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;&lt;i&gt;= E(t) -&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;d_h * E(t)&lt;/i&gt;&lt;/b&gt;&lt;b style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: initial;&quot;&gt;&lt;i&gt;&amp;nbsp;- O(t)&lt;/i&gt;&lt;/b&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: initial;&quot;&gt;&lt;i&gt;= (1 - d_h) * E(t) - O(t)&lt;/i&gt;&lt;/b&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;i&gt;S_c&lt;/i&gt;&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;sediment volume stored in the channel system, m^3&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;i&gt;d_h&lt;/i&gt;&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;hillslope redeposition fraction, no unit&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;i&gt;E_h(t)&lt;/i&gt;&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;hillslope erosion rate, m^3 / h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;b&gt;&lt;i&gt;O(t)&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;sediment discharge leaving the catchment, m^3/h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;background-color: rgb(151, 208, 119);&quot;&gt;for O(t)&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;i style=&quot;&quot;&gt;if&lt;/i&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;&quot;&gt;S_c(t) &amp;gt;= O_pot(t) * delta_t, then,&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;XGxPhHScu9QLlKaS9fka&quot;&gt;&lt;b&gt;&lt;i&gt;O(t) =&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;O_pot(t)&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;&quot;&gt;if&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;S_c(t) &amp;lt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;O_pot(t) * delta_t,&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;&quot;&gt;&amp;nbsp;then,&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;O(t) =&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;S_c(t)&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;background-color: rgb(151, 208, 119);&quot;&gt;for O_pot(t)&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: rgb(234, 107, 102);&quot;&gt;&lt;i style=&quot;&quot;&gt;if Q_s(t) &amp;gt;= Q_df, then,&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;O_pot(t) = s_max * Q(t) * A&lt;/i&gt;&lt;/b&gt;&lt;span style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i style=&quot;&quot;&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: XGxPhHScu9QLlKaS9fka; background-color: rgb(234, 107, 102);&quot;&gt;&lt;i style=&quot;&quot;&gt;if Q_s(t) &amp;lt; Q_df, then,&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;O_pot(t) = a * Q(t)^b * A&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: initial; font-family: XGxPhHScu9QLlKaS9fka;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
