        <mxCell id="CTnxqsF6KA1l9jbKLsUk-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeWidth=1;fontSize=10;strokeColor=#000000;align=left;imageHeight=50;" value="&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b&gt;&lt;i&gt;r&lt;/i&gt;&lt;/b&gt;=1,&amp;nbsp;&lt;/font&gt;first reservoir&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;theta_S_w(h, r=1), water storage capacity&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;S_w(t, h, r=1), changes in water storage&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;for Q_sur(t), surface runoff&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;if&amp;nbsp;S_w(t, h, r=1) &amp;lt;=&amp;nbsp;theta_S_w(h, r=1)&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;Q_sur(t, h) = 0&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;else:&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;Q_sur(t, h) =&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;S_w(t, h, r=1) -&amp;nbsp;theta_S_w(h, r=1)&lt;/span&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;for Q_sub(t)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;if&amp;nbsp;S_w(t, h, &lt;b&gt;r=i+1=2&lt;/b&gt;) =&amp;nbsp;theta_S_w(h, &lt;b&gt;r=i+1=2&lt;/b&gt;)&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;Q_sub(t, h,&amp;nbsp;&lt;b&gt;r=1&lt;/b&gt;) = 0&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;elif&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;S_w(t, h,&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: initial; font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;r=i+1=2&lt;/b&gt;&lt;span style=&quot;background-color: initial; font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;) &amp;lt;&amp;nbsp;theta_S_w(h,&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: initial; font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;r=i+1=2&lt;/b&gt;&lt;span style=&quot;background-color: initial; font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF; text-align: center; text-wrap: nowrap; background-color: initial;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF; text-align: center; text-wrap: nowrap;&quot;&gt;Q_sub(t, h,&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-family: B3KYH17XZSQlytHpybfF; text-align: center; text-wrap: nowrap;&quot;&gt;r=1&lt;/b&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF; text-align: center; text-wrap: nowrap;&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;= [1/(k(h, i=1))] * S_w(t, h, i=1)&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;B3KYH17XZSQlytHpybfF&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap;&quot;&gt;else&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;S_w(t, h,&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;r=i+1=2&lt;/b&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;) &lt;/span&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;&amp;nbsp;theta_S_w(h,&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;r=i+1=2&lt;/b&gt;&lt;span style=&quot;font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;?&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: rgb(234, 107, 102); font-family: B3KYH17XZSQlytHpybfF;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: rgb(234, 107, 102);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
