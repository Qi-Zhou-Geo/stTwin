 0, 0);&quot;&gt;(2)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(26, 23, 24); background-color: initial; text-wrap: wrap;&quot;&gt;critical discharge &lt;/span&gt;&lt;span style=&quot;background-color: initial; text-wrap: wrap;&quot;&gt;&lt;font color=&quot;#ea6b66&quot;&gt;Q_tau&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;color: rgb(26, 23, 24); background-color: initial; text-wrap: wrap;&quot;&gt;(3)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(26, 23, 24); background-color: initial; text-wrap: wrap;&quot;&gt;dry bulk density of debris flow &lt;/span&gt;&lt;span style=&quot;background-color: initial; text-wrap: wrap;&quot;&gt;&lt;font color=&quot;#ea6b66&quot;&gt;rho_df&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: initial; text-wrap: wrap;&quot;&gt;(4)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: initial; text-wrap: wrap;&quot;&gt;dry bulk density of hillslope sediment stored in the&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: initial; text-wrap: wrap;&quot;&gt;channel &lt;/span&gt;&lt;span style=&quot;background-color: initial; text-wrap: wrap;&quot;&gt;&lt;font color=&quot;#ea6b66&quot;&gt;rho_h&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: initial; text-wrap: wrap;&quot;&gt;(5)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: initial; text-wrap: wrap;&quot; class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: initial; text-wrap: wrap;&quot;&gt;a maximum ratio of sediment to water in a discharge event unlimited by sediment supply &lt;/span&gt;&lt;span style=&quot;background-color: initial; text-wrap: wrap;&quot;&gt;&lt;font color=&quot;#ea6b66&quot;&gt;s_max&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;If &lt;b&gt;(rho_df / rho_h) * s_max * [RO(t) - Q_tau] &amp;lt; S_c(t)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: initial;&quot; color=&quot;#000000&quot;&gt;O_c(t) =&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: initial; color: rgb(0, 0, 0);&quot;&gt;(rho_df / rho_h) * s_max * [RO(t) - Q_tau]&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial; color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial; color: rgb(0, 0, 0);&quot;&gt;If&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: initial; color: rgb(0, 0, 0);&quot;&gt;(rho_df / rho_h) * s_max * [RO(t) - Q_tau] &amp;gt;= S_c(t)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: initial; color: rgb(0, 0, 0);&quot;&gt;O_c(t) = S_c(t)&lt;/b&gt;&lt;/div&gt;&lt;/span&gt;" vertex="1">
