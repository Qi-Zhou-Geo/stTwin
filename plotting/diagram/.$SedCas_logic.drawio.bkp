        <mxCell id="bo7lOUkn4_HwYJ835JLc-103" parent="bo7lOUkn4_HwYJ835JLc-172" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeWidth=1;fontSize=10;strokeColor=#000000;align=center;imageHeight=50;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;$$ S_o(t) = \frac{1}{1- s2w} \times Q_s(t) \times E(t) $$&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Sediments&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;entrainment&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;$$ E(t) = 1 + e_k \frac{ch(t)}{ch^{\ast}} $$&lt;/span&gt;&lt;/div&gt;" vertex="1">
